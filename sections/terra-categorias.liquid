{%- assign s = section.settings -%}
<section class="t-section t-bg-areia" style="padding-top: 0;">
  <div class="t-wrap t-row">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.colecao -%}
      <a href="{% if c != blank %}{{ c.url }}{% else %}#{% endif %}" class="t-stack" style="flex: 1 1 300px; gap: 12px; text-decoration: none; color: var(--terra-castanho);" {{ block.shopify_attributes }}>
        <div class="t-photo" style="aspect-ratio: 4 / 3;">
          {%- if block.settings.imagem != blank -%}
            {{ block.settings.imagem | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '400, 600, 900', alt: block.settings.imagem.alt }}
          {%- elsif c.image -%}
            {{ c.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw', widths: '400, 600, 900' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <span class="t-display" style="font-size: 26px;">{{ block.settings.titulo | default: c.title }}</span>
        {%- if block.settings.texto != blank -%}<span>{{ block.settings.texto }}</span>{%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Terra · Categorias",
  "tag": "div",
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoria",
      "settings": [
        { "type": "collection", "id": "colecao", "label": "Coleção" },
        { "type": "text", "id": "titulo", "label": "Título (opcional)" },
        { "type": "text", "id": "texto", "label": "Texto" },
        { "type": "image_picker", "id": "imagem", "label": "Foto" }
      ]
    }
  ],
  "presets": [{ "name": "Terra · Categorias", "blocks": [{ "type": "categoria" }, { "type": "categoria" }, { "type": "categoria" }] }]
}
{% endschema %}
