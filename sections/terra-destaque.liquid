{%- assign s = section.settings -%}
<section class="t-section t-bg-{{ s.fundo }}">
  <div class="t-wrap t-feature">
    <div class="t-photo t-feature__media">
      {%- if s.imagem != blank -%}
        {{ s.imagem | image_url: width: 1600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 55vw, 100vw', widths: '600, 900, 1200, 1600', alt: s.imagem.alt }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
    <div class="t-feature__text">
      {%- if s.ilu != blank and s.ilu != 'nenhuma' -%}<img class="t-ilu" src="{{ s.ilu | asset_url }}" alt="" loading="lazy" width="640" height="640" style="width: 84px; height: auto;">{%- endif -%}
      {%- if s.eyebrow != blank -%}<p class="t-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="t-display t-feature__title">{{ s.titulo }}</h2>
      <div class="t-lead t-rte">{{ s.texto }}</div>
      {%- if s.botao != blank -%}<div><a class="t-btn" href="{{ s.link | default: '#' }}">{{ s.botao }}</a></div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
