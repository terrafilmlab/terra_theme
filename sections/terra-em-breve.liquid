{%- comment -%}
  Terra · Página "em breve" (template password). Mostra-se a quem visita a loja enquanto está protegida por palavra-passe.
{%- endcomment -%}
{%- assign s = section.settings -%}
<div class="tb">
  <div class="tb__bar">
    <span>{{ s.antetitulo }}</span>
    <button type="button" class="tb__entrar" onclick="var d=document.querySelector('#password-form dialog'); if(d){d.showModal ? d.showModal() : d.setAttribute('open','');}">Entrar</button>
  </div>

  <main class="tb__main">
    {%- if s.logo != blank -%}
      {{ s.logo | image_url: width: 1040 | image_tag: class: 'tb__logo', alt: shop.name }}
    {%- else -%}
      <img class="tb__logo" src="{{ 'terra-logo-filmlab.webp' | asset_url }}" alt="{{ shop.name | escape }}" width="2560" height="1129">
    {%- endif -%}
    <h1 class="tb__titulo">{{ s.titulo }}</h1>
    {%- if s.subtitulo != blank -%}<p class="tb__sub">{{ s.subtitulo }}</p>{%- endif -%}
  </main>

  <footer class="tb__footer">
    {%- if s.email != blank -%}<a href="mailto:{{ s.email }}">{{ s.email }}</a>{%- endif -%}
    {%- if s.instagram != blank -%}<a href="{{ s.instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
  </footer>
</div>

<style>
  body { margin: 0; background: var(--terra-areia); }
  .password-main-content { padding: 0 !important; max-width: none !important; }
  .tb { min-height: 100vh; display: flex; flex-direction: column; background: var(--terra-areia); color: var(--terra-castanho); font-family: "Gantari", system-ui, sans-serif; font-size: 17px; line-height: 1.5; }
  .tb__bar { background: var(--terra-castanho); color: var(--terra-creme); display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 10px 24px; font-size: 14px; letter-spacing: .04em; }
  .tb__entrar { background: transparent; border: 1.5px solid var(--terra-creme); color: var(--terra-creme); border-radius: 999px; padding: 6px 16px; min-height: 36px; font: inherit; font-weight: 600; cursor: pointer; }
  .tb__entrar:hover { background: var(--terra-creme); color: var(--terra-castanho); }
  .tb__main { flex: 1; width: 100%; max-width: 880px; margin: 0 auto; padding: 64px 24px 56px; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 22px; }
  .tb__logo { width: min(520px, 50%); height: auto; display: block; }
  .tb__titulo { font-family: "Bowlby One SC", Impact, sans-serif; font-weight: 400; font-size: 34px; line-height: 1; margin: 12px 0 0; letter-spacing: .01em; }
  .tb__sub { margin: -8px 0 0; font-size: 15px; opacity: .75; }
  .tb__footer { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 28px; padding: 24px; font-size: 14px; border-top: 1px solid rgba(72,25,28,.2); }
  .tb__footer a { color: var(--terra-castanho); }
  .tb__footer a:hover { color: var(--terra-azul); }
  @media (max-width: 600px) { .tb__logo { width: 80%; } }
</style>

{% schema %}
{
  "name": "Terra · Em breve",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "antetitulo", "label": "Barra de topo", "default": "Community Film Lab - Porto" },
    { "type": "image_picker", "id": "logo", "label": "Logo (opcional, substitui o logo Terra Film Lab)" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "work in progress" },
    { "type": "text", "id": "subtitulo", "label": "Subtítulo", "default": "A film lab opening soon in Porto." },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@terrafilmlab.com" },
    { "type": "url", "id": "instagram", "label": "Instagram (opcional)" }
  ],
  "presets": [{ "name": "Terra · Em breve" }]
}
{% endschema %}
