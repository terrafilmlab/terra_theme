{%- comment -%} Terra · Fotos da comunidade. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="t-section t-bg-creme">
  <div class="t-wrap t-stack" style="gap: 28px;">
    <div class="t-head" style="margin: 0;">
      <h2 class="t-display t-h2">{{ s.titulo }}</h2>
      {%- if s.texto != blank -%}<div class="t-rte" style="max-width: 30em;">{{ s.texto }}</div>{%- endif -%}
    </div>
    <div class="t-row t-gallery" style="gap: 16px;">
      {%- for block in section.blocks -%}
        <figure {{ block.shopify_attributes }}>
          <div class="t-photo">
            {%- if block.settings.imagem != blank -%}
              {{ block.settings.imagem | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '400, 600, 900', alt: block.settings.imagem.alt }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          {%- if block.settings.legenda != blank -%}<figcaption>{{ block.settings.legenda }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Terra · Galeria",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Fotos da comunidade" },
    { "type": "richtext", "id": "texto", "label": "Texto", "default": "<p>Marca @terrafilmlab no Instagram.<br>Vamos adorar ver as tuas fotografias aqui</p>" }
  ],
  "blocks": [
    { "type": "foto", "name": "Foto", "settings": [
      { "type": "image_picker", "id": "imagem", "label": "Imagem" },
      { "type": "text", "id": "legenda", "label": "Legenda", "default": "@autor · película" }
    ] }
  ],
  "presets": [{ "name": "Terra · Galeria", "blocks": [ { "type": "foto" }, { "type": "foto" }, { "type": "foto" }, { "type": "foto" } ] }]
}
{% endschema %}
