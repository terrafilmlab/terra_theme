{%- comment -%} Terra · Hero da homepage, com a etiqueta de envelope desenhada no canvas. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="t-section t-bg-areia" style="padding-top: 56px;">
  <div class="t-wrap t-hero">
    <div class="t-hero__text">
      <h1 class="t-display t-hero__title">{{ s.titulo }}</h1>
      {%- if s.texto != blank -%}<div class="t-lead t-rte" style="font-size: 20px; max-width: 30em;">{{ s.texto }}</div>{%- endif -%}
      <div class="t-row" style="align-items: center; gap: 14px 28px;">
        {%- if s.botao1 != blank -%}<a class="t-btn" href="{{ s.link1 | default: '/collections/revelacao-scan' }}">{{ s.botao1 }}</a>{%- endif -%}
        {%- if s.botao2 != blank -%}<a class="t-link" href="{{ s.link2 | default: '#precos' }}">{{ s.botao2 }}</a>{%- endif -%}
      </div>
    </div>
    <div class="t-hero__media t-hero__media--label">
      <div class="t-label-card">
        <div class="t-label-card__top">
          <img src="{{ 'terra-logo-filmlab-castanho.webp' | asset_url }}" alt="" width="1200" height="529" style="width: 120px; height: auto;">
          <span class="t-display" style="font-size: 30px;">{{ s.numero }}</span>
        </div>
        <div class="t-label-card__grid">
          <span>{{ 'terra.label.name' | t }}</span><strong>{{ s.l_nome }}</strong>
          <span>{{ 'terra.label.rolls' | t }}</span><strong>{{ s.l_rolos }}</strong>
          <span>{{ 'terra.label.process' | t }}</span><strong>{{ s.l_processo }}</strong>
          <span>{{ 'terra.label.scan' | t }}</span><strong>{{ s.l_scan }}</strong>
          <span>{{ 'terra.label.negatives' | t }}</span><strong>{{ s.l_negativos }}</strong>
          <img class="t-label-card__ilu" src="{{ 'terra-ilu-04-castanho.webp' | asset_url }}" alt="" width="640" height="834" loading="eager">
        </div>
        <div class="t-label-card__barcode" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Terra · Hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Revelamos filme no <em>Bonfim</em>." },
    { "type": "richtext", "id": "texto", "label": "Texto", "default": "<p>C-41, preto e branco, E-6 e ECN-2. Deixas os rolos <strong>no balcão, na Rua Duque de Saldanha</strong>, ou mandas <strong>pela DPD de qualquer ponto do país</strong>. Os scans chegam-te por email.</p>" },
    { "type": "text", "id": "botao1", "label": "Botão principal", "default": "Revelar os meus rolos" },
    { "type": "url", "id": "link1", "label": "Link do botão principal" },
    { "type": "text", "id": "botao2", "label": "Link secundário", "default": "Preços" },
    { "type": "text", "id": "link2", "label": "Destino do link secundário", "default": "#precos" },
    { "type": "header", "content": "Etiqueta de envelope" },
    { "type": "text", "id": "numero", "label": "Número", "default": "Nº 0001" },
    { "type": "text", "id": "l_nome", "label": "Nome", "default": "Terra Film Lab" },
    { "type": "text", "id": "l_rolos", "label": "Rolos", "default": "3" },
    { "type": "text", "id": "l_processo", "label": "Processo", "default": "C-41 · 35 mm" },
    { "type": "text", "id": "l_scan", "label": "Scan", "default": "Standard" },
    { "type": "text", "id": "l_negativos", "label": "Negativos", "default": "Guardar no lab" }
  ],
  "presets": [{ "name": "Terra · Hero" }]
}
{% endschema %}
