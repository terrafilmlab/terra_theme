{%- comment -%}
  Terra · Pedir os meus negativos. Modelo de produto "negativos".
  O produto tem uma única variante cujo preço são os portes DPD da devolução e precisa de envio,
  para o checkout pedir a morada. As escolhas do cliente seguem como propriedades da linha.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign v = product.selected_or_first_available_variant
  assign sid = section.id
-%}
<section class="t-section t-bg-areia" style="padding-top: 24px;">
  <div class="t-wrap t-order">
    <div class="t-stack" style="flex: 1 1 440px; gap: 24px;">
      <img class="t-ilu" src="{{ 'terra-ilu-61-castanho.webp' | asset_url }}" alt="" width="640" height="542" style="width: 140px; height: auto;">
      <h1 class="t-display" style="font-size: clamp(40px, 5vw, 68px);">{{ product.title }}</h1>
      <div class="t-lead t-rte">{{ product.description }}</div>
      <div class="t-stack" style="gap: 16px;">
        <div class="t-steps-num"><span class="t-display">01</span><span>{{ 'terra.neg.step1' | t }}</span></div>
        <div class="t-steps-num"><span class="t-display">02</span><span>{{ 'terra.neg.step2' | t }}</span></div>
        <div class="t-steps-num"><span class="t-display">03</span><span>{{ 'terra.neg.step3' | t }}</span></div>
      </div>
      {%- if s.nota != blank -%}<div class="t-info t-rte" style="flex: none; padding: 18px 20px; font-size: 15px;">{{ s.nota }}</div>{%- endif -%}
    </div>

    <form class="t-stack" id="terra-neg-{{ sid }}" style="flex: 1 1 460px; background: var(--terra-branco); border-radius: 8px; padding: 32px; gap: 22px;" novalidate>
      <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 16px;">
        <h2 class="t-display" style="font-size: 28px;">{{ 'terra.neg.title' | t }}</h2>
        <span style="color: var(--terra-azul); font-weight: 700; font-size: 22px;">{{ v.price | money }}</span>
      </div>

      <fieldset class="t-field">
        <legend>{{ 'terra.neg.what' | t }}</legend>
        <button type="button" class="t-choice" data-tipo="todos" aria-pressed="true">
          <span class="t-choice__top"><span>{{ 'terra.neg.all' | t }}</span></span>
          <span class="t-choice__sub">{{ 'terra.neg.all_sub' | t }}</span>
        </button>
        <button type="button" class="t-choice" data-tipo="esp" aria-pressed="false">
          <span class="t-choice__top"><span>{{ 'terra.neg.some' | t }}</span></span>
          <span class="t-choice__sub">{{ 'terra.neg.some_sub' | t }}</span>
        </button>
      </fieldset>

      <div class="t-field" data-esp hidden>
        <label class="t-label" for="enc-{{ sid }}" style="margin: 0;">{{ 'terra.neg.numbers' | t }}</label>
        <input class="t-input" id="enc-{{ sid }}" type="text" placeholder="{{ 'terra.neg.numbers_ph' | t }}">
        <span class="t-small">{{ 'terra.neg.numbers_help' | t }}</span>
      </div>

      <div class="t-field">
        <label class="t-label" for="mail-{{ sid }}" style="margin: 0;">{{ 'terra.neg.email' | t }}</label>
        <input class="t-input" id="mail-{{ sid }}" type="email" autocomplete="email" placeholder="{{ 'terra.common.email_ph' | t }}" {% if customer %}value="{{ customer.email }}"{% endif %}>
      </div>

      <button type="submit" class="t-btn t-btn--full" {% unless v.available %}disabled{% endunless %}>{{ 'terra.neg.submit' | t }}</button>
      <p class="t-error" data-erro hidden></p>
      <p class="t-small">{{ 'terra.neg.note' | t: n: s.meses_arquivo }}</p>
    </form>
  </div>
</section>

<script>
  (function () {
    var form = document.getElementById('terra-neg-{{ sid }}');
    if (!form) return;
    var tipo = 'todos';
    var T = {
      noMail: {{ 'terra.neg.err_mail' | t | json }},
      noOrder: {{ 'terra.neg.err_order' | t | json }},
      fail: {{ 'terra.neg.err_fail' | t | json }},
      pReq: {{ 'terra.neg.prop_request' | t | json }},
      pMail: {{ 'terra.neg.prop_email' | t | json }},
      pOrders: {{ 'terra.neg.prop_orders' | t | json }},
      all: {{ 'terra.neg.all' | t | json }},
      some: {{ 'terra.neg.some' | t | json }}
    };
    var esp = form.querySelector('[data-esp]');
    var erro = form.querySelector('[data-erro]');
    form.addEventListener('click', function (e) {
      var b = e.target.closest('[data-tipo]');
      if (!b) return;
      tipo = b.dataset.tipo;
      form.querySelectorAll('[data-tipo]').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      esp.hidden = tipo !== 'esp';
    });
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var enc = document.getElementById('enc-{{ sid }}').value.trim();
      var mail = document.getElementById('mail-{{ sid }}').value.trim();
      erro.hidden = true;
      if (!mail || mail.indexOf('@') < 1) { erro.textContent = T.noMail; erro.hidden = false; return; }
      if (tipo === 'esp' && !enc) { erro.textContent = T.noOrder; erro.hidden = false; return; }
      var props = {}; props[T.pReq] = tipo === 'todos' ? T.all : T.some; props[T.pMail] = mail;
      if (tipo === 'esp') props[T.pOrders] = enc;
      fetch({{ routes.cart_add_url | append: '.js' | json }}, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: [{ id: {{ v.id }}, quantity: 1, properties: props }] })
      })
        .then(function (r) {
          if (!r.ok) return r.json().then(function (j) { throw new Error(j.description || 'Erro'); });
          window.location.href = '/checkout';
        })
        .catch(function (err) { erro.textContent = T.fail + ' ' + err.message; erro.hidden = false; });
    });
  })();
</script>

{% schema %}
{
  "name": "Terra · Pedir negativos",
  "tag": "div",
  "settings": [
    { "type": "number", "id": "meses_arquivo", "label": "Meses de arquivo grátis", "default": 3 },
    { "type": "richtext", "id": "nota", "label": "Nota", "default": "<p>Preferes vir buscar? Passa pelo lab na Rua Duque de Saldanha 345. Não precisas de fazer pedido.</p>" }
  ],
  "presets": [{ "name": "Terra · Pedir negativos" }]
}
{% endschema %}
