{%- assign s = section.settings -%}
<section class="t-section t-bg-{{ s.fundo }}" id="processos">
  <div class="t-wrap">
    <div class="t-head">
      <h2 class="t-display t-h2">{{ s.titulo }}</h2>
      {%- if s.link_texto != blank -%}<a href="{{ s.link | default: '#' }}">{{ s.link_texto }}</a>{%- endif -%}
    </div>
    <div class="t-row">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <a class="t-card" href="{{ b.link | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="t-photo">
            {%- if b.imagem != blank -%}
              {{ b.imagem | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', widths: '400, 600, 800', alt: b.imagem.alt }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="t-card__body">
            <span class="t-display" style="font-size: 30px;">{{ b.titulo }}</span>
            <span>{{ b.subtitulo }}</span>
            <span class="t-card__price">{{ b.preco }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Terra · Processos",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Revelação & Scan" },
    { "type": "text", "id": "link_texto", "label": "Texto do link", "default": "Ver todos os preços" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "select", "id": "fundo", "label": "Fundo", "default": "creme", "options": [
      { "value": "areia", "label": "Areia" }, { "value": "creme", "label": "Creme" }
    ] }
  ],
  "blocks": [
    {
      "type": "processo",
      "name": "Processo",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "C-41" },
        { "type": "text", "id": "subtitulo", "label": "Descrição", "default": "Negativo a cores · 35mm, 120" },
        { "type": "text", "id": "preco", "label": "Preço", "default": "desde X €" },
        { "type": "image_picker", "id": "imagem", "label": "Foto" },
        { "type": "url", "id": "link", "label": "Link (produto)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Terra · Processos",
      "blocks": [
        { "type": "processo", "settings": { "titulo": "C-41", "subtitulo": "Negativo a cores · 35mm, 120" } },
        { "type": "processo", "settings": { "titulo": "P&B", "subtitulo": "Preto e branco · 35mm, 120" } },
        { "type": "processo", "settings": { "titulo": "E-6", "subtitulo": "Diapositivo · 35mm, 120" } },
        { "type": "processo", "settings": { "titulo": "ECN-2", "subtitulo": "Película de cinema · 35mm" } }
      ]
    }
  ]
}
{% endschema %}
