{%- comment -%} Terra · Passa pelo lab. {%- endcomment -%}
{%- assign s = section.settings -%}
<section class="t-section t-bg-creme" id="lab">
  <div class="t-wrap t-visit">
    <div class="t-visit__text" style="gap: 18px;">
      <h2 class="t-display t-h2">{{ s.titulo }}</h2>
      <div class="t-rte" style="font-size: 20px;">{{ s.morada }}</div>
      {%- if s.horario != blank -%}<div class="t-rte">{{ s.horario }}</div>{%- endif -%}
      {%- if s.aviso != blank -%}<div class="t-rte" style="font-size: 15px;">{{ s.aviso }}</div>{%- endif -%}
      {%- if s.email != blank -%}<p style="margin: 0;">{{ s.email_texto }} <a href="mailto:{{ s.email }}">{{ s.email }}</a>.</p>{%- endif -%}
      {%- if s.mapa != blank -%}<div><a class="t-link" href="{{ s.mapa }}" target="_blank" rel="noopener">{{ 'terra.visit.map' | t }}</a></div>{%- endif -%}
    </div>
    <div class="t-photo t-visit__media">
      {%- if s.imagem != blank -%}
        {{ s.imagem | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 55vw, 100vw', widths: '600, 900, 1400', alt: s.imagem.alt }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Terra · Passa pelo lab",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Passa <em>pelo lab</em>" },
    { "type": "richtext", "id": "morada", "label": "Morada", "default": "<p>Rua Duque de Saldanha 345<br>4300-465 Porto, no Bonfim</p>" },
    { "type": "richtext", "id": "horario", "label": "Horário", "default": "<p>Dias e horas de abertura</p>" },
    { "type": "richtext", "id": "aviso", "label": "Aviso", "default": "<p>Se fecharmos fora do normal, por férias ou feriados, avisamos aqui e na barra do topo.</p>" },
    { "type": "text", "id": "email_texto", "label": "Texto antes do email", "default": "Dúvidas antes de mandar os rolos? Escreve para" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@terrafilmlab.com" },
    { "type": "url", "id": "mapa", "label": "Link do mapa" },
    { "type": "image_picker", "id": "imagem", "label": "Foto (a porta do 345)" }
  ],
  "presets": [{ "name": "Terra · Passa pelo lab" }]
}
{% endschema %}
