{%- comment -%}
  Terra · fontes da marca, cores e folha de estilos própria.
  Carregado em layout/theme.liquid depois das variáveis do tema, por isso sobrepõe-se a elas.
{%- endcomment -%}
<link rel="preload" href="{{ 'terra-gantari.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ 'terra-bowlby-one-sc.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
<style>
  @font-face {
    font-family: "Gantari";
    src: url({{ 'terra-gantari.woff2' | asset_url }}) format("woff2");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Bowlby One SC";
    src: url({{ 'terra-bowlby-one-sc.woff2' | asset_url }}) format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  :root {
    --font-body--family: "Gantari", system-ui, sans-serif;
    --font-subheading--family: "Gantari", system-ui, sans-serif;
    --font-heading--family: "Bowlby One SC", Impact, sans-serif;
    --font-heading--weight: 400;
    --font-heading--style: normal;
    --font-accent--family: "Bowlby One SC", Impact, sans-serif;
    --font-accent--weight: 400;
    --font-accent--style: normal;

    --terra-areia: #E8DFC7;
    --terra-castanho: #48191C;
    --terra-azul: #2E5D96;
    --terra-azul-escuro: #244B7A;
    --terra-creme: #F8F2E0;
    --terra-terracota: #8F4739;
    --terra-foto: #D6C9A8;
  }
</style>
{{ 'terra.css' | asset_url | stylesheet_tag }}
